# Locally built runtime image; normal builds reuse the saved BASE_IMAGE.
IMAGE_NAME=ghcr.io/delfianto/comfyui-nvidia-cuda
IMAGE_TAG=latest
# Build separately with ./build.sh --pull base before the first runtime build.
# Choose a new base tag when changing CUDA/Torch versions below.
BASE_IMAGE=ghcr.io/delfianto/comfyui-base:cuda13.4.2-torch2.11.0
CUDA_IMAGE=nvidia/cuda:13.4.2-base-ubuntu24.04

# Matched Torch/TorchVision/TorchAudio trio; ComfyUI still imports TorchAudio.
TORCH_VERSION=2.11.0
TORCHVISION_VERSION=0.26.0
TORCHAUDIO_VERSION=2.11.0
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130

# Follow the latest stable release, or set an explicit tag/commit SHA to pin.
COMFYUI_REPOSITORY=https://github.com/Comfy-Org/ComfyUI.git
COMFYUI_REF=latest-stable
COMFYUI_AUTO_UPDATE=true
# When false, a temporary GitHub outage falls back to the version in the image.
COMFYUI_UPDATE_STRICT=false
# Reinstall requirements discovered under persisted custom-node directories.
COMFYUI_INSTALL_CUSTOM_NODE_REQUIREMENTS=true

# Mutable/valuable state stays together outside the image.
DATA_DIR=/srv/appdata/comfyui
OUTPUT_DIR=${HOME}/Pictures/StableDiffusion
