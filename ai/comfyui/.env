# Locally built runtime image. Rebuild with --pull to update CUDA/Ubuntu.
IMAGE_NAME=ghcr.io/delfianto/comfyui-nvidia-cuda
IMAGE_TAG=latest
CUDA_IMAGE=nvidia/cuda:13.2.1-base-ubuntu24.04

# Latest complete matched Torch/TorchVision/TorchAudio trio. PyTorch 2.12's
# cu132 channel does not publish TorchAudio, which current ComfyUI still uses.
TORCH_VERSION=2.11.0
TORCHVISION_VERSION=0.26.0
TORCHAUDIO_VERSION=2.11.0
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130

# Use master for automatic ComfyUI application updates, or a commit SHA to pin.
COMFYUI_REPOSITORY=https://github.com/Comfy-Org/ComfyUI.git
COMFYUI_REF=master
COMFYUI_AUTO_UPDATE=true
# When false, a temporary GitHub outage falls back to the version in the image.
COMFYUI_UPDATE_STRICT=false
# Reinstall requirements discovered under persisted custom-node directories.
COMFYUI_INSTALL_CUSTOM_NODE_REQUIREMENTS=true

# Image-owned custom nodes. The main refs capture their latest commits whenever
# the image is rebuilt; do not update these copies through ComfyUI Manager.
COMFYUI_GGUF_REPOSITORY=https://github.com/city96/ComfyUI-GGUF.git
COMFYUI_GGUF_REF=main
COMFYUI_MULTIGPU_REPOSITORY=https://github.com/pollockjj/ComfyUI-MultiGPU.git
COMFYUI_MULTIGPU_REF=main

# Mutable/valuable state stays together outside the image.
DATA_DIR=/srv/appdata/comfyui
OUTPUT_DIR=${HOME}/Pictures/StableDiffusion
