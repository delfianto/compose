# Runtime images (built in delfianto/comfyui-docker)
IMAGE_NAME=ghcr.io/delfianto/comfyui-app
IMAGE_TAG=latest
IMAGE_PROXY_NAME=ghcr.io/delfianto/comfyui-proxy
IMAGE_PROXY_TAG=latest

# ComfyUI runtime configuration
COMFYUI_REPOSITORY=https://github.com/Comfy-Org/ComfyUI.git
# Keep the bundled release, including older troubleshooting builds.
COMFYUI_AUTO_UPDATE=false
# When false, a temporary GitHub outage falls back to the version in the image.
COMFYUI_UPDATE_STRICT=false
# Reinstall requirements discovered under persisted custom-node directories.
COMFYUI_INSTALL_CUSTOM_NODE_REQUIREMENTS=true

# Mutable/valuable state stays together outside the image.
DATA_DIR=/srv/appdata/comfyui
OUTPUT_DIR=${HOME}/Pictures/ComfyUI

# Official local API proxy
PROXY_PORT=8189
