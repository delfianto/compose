# SmartGallery's Docker image includes FFmpeg for image, video, and audio previews.
IMAGE_NAME=mmartial/smart-comfyui-gallery
IMAGE_TAG=2.16

DATA_DIR=/srv/appdata/smartgallery
INPUT_DIR=/srv/appdata/comfyui/input
MODELS_DIR=/srv/appdata/comfyui/models
OUTPUT_DIR=${HOME}/Pictures/StableDiffusion
SECRET_DIR=/srv/appdata/secret
