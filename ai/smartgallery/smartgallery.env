# Container paths corresponding to the bind mounts in compose.yaml.
BASE_OUTPUT_PATH=/mnt/output
BASE_INPUT_PATH=/mnt/input
BASE_MODELS_PATH=/mnt/models
BASE_SMARTGALLERY_PATH=/mnt/SmartGallery

# Used by SmartGallery's Remix workflow feature; no startup dependency is
# required, so the gallery remains usable while ComfyUI is offline.
COMFYUI_SERVER_URL=http://comfy:8188

# Rootless Docker maps container uid/gid 0 to the host daemon owner.
WANTED_UID=0
WANTED_GID=0

# The forced-login password is injected from the smartgallery_admin
# Docker secret and expanded into CLI_ARGS by /secret-env.sh.
