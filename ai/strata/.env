# Compose interpolation defaults. ./compose.sh also loads .env.local last.
DATA_DIR=/srv/appdata/strata
# Local image name in the same GHCR namespace as the other custom builds.
IMAGE_REPO=ghcr.io/delfianto/strata
# Upstream release tag, used for both the source checkout and local image tag.
STRATA_VERSION=v0.1.41
# RTX 3060 (Ampere, 86) and RTX 4080 (Ada, 89).
# Compile on the host where the image will run; keep this shell-compatible.
CUDA_ARCHITECTURES='86;89'
BUILD_VISION=1
# Must not exceed the rootless Docker daemon's hard memlock limit (32 GiB here).
MEMLOCK_BYTES=34359738368
