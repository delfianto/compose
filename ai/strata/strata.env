# Runtime setup choices. The first start downloads and prepares the model.
FAMILY=qwen
MODEL=IQ3_S
CONTEXT=32768
VISION=no
KV=int8
# Explicit selection prevents setup from silently using only one card.
# auto sizes expert caches using free VRAM, and orders the faster GPU last.
GPUS=0,1
LAYER_SPLIT=auto
# Keep separate prompt buffers only where their VRAM cost meets the
# upstream heuristic. Do not force this to 1 without measuring.
STRATA_SPLIT_OWN=auto
HOST=0.0.0.0
PORT=8080
# No container memory cap: setup may use the host's available RAM.
LOW_RAM=auto
# For an already installed model, temporarily set REINSTALL=1 to change
# context, vision, KV, host, or API key; remove it after that setup pass.
