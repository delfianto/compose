# Image is built in github.com/delfianto/ai-toolkit-docker, never in this repo.
AI_TOOLKIT_IMAGE=ghcr.io/delfianto/ai-toolkit:latest
MODEL_CATALOG=/srv/appdata/toolkit/config/models.json
# Keep existing data paths so jobs, datasets and output history survive the rename.
DATA_DIR=/srv/appdata/toolkit
SECRET_DIR=/srv/appdata/secret
# Host training images and shared ComfyUI weights.
DATASETS_DIR=/srv/appdata/toolkit/datasets
COMFY_MODELS_DIR=/srv/appdata/comfyui/models
