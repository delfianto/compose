IMAGE_NAME=ghcr.io/delfianto/lychee
IMAGE_TAG=v0.1.0-beta.13

DATA_DIR=/srv/appdata/lychee
# Writable for chapter downloads, imports, and metadata sidecars.
# Override in .env.local to use an existing manga collection.
LIBRARY_DIR=/srv/appdata/lychee/library
# SECRET_DIR is normally supplied by the machine-wide compose.env.
SECRET_DIR=/srv/appdata/secret
