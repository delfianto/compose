# GHCR image, built from the remote repository by ./build.sh.
IMAGE_NAME=ghcr.io/delfianto/lychee
IMAGE_TAG=latest
LYCHEE_REPOSITORY=https://github.com/delfianto/lychee.git
# Branch, tag, or commit. build.sh resolves it to a commit before building.
LYCHEE_REF=main
PYTHON_IMAGE=python:3.14-slim-trixie
NODE_IMAGE=node:24-trixie-slim
BUN_IMAGE=oven/bun:1.4.4
UV_IMAGE=ghcr.io/astral-sh/uv:latest

DATA_DIR=/srv/appdata/lychee
# Writable for chapter downloads, imports, and metadata sidecars.
# Override in .env.local to use an existing manga collection.
LIBRARY_DIR=/srv/appdata/lychee/library
# SECRET_DIR is normally supplied by the machine-wide compose.env.
SECRET_DIR=/srv/appdata/secret
