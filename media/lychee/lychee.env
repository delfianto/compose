ENVIRONMENT=production
DATABASE_URL=sqlite:////data/lychee.db
# Also the root exposed by Lychee's library/import folder browser.
STORAGE_PATH=/library
LOG_LEVEL=INFO
LOG_FORMAT=json
# The frontend and API share an origin; no cross-origin clients by default.
CORS_ORIGINS=[]
# Increase for parallel AVIF encoding during imports/downloads.
LYCHEE_ENCODE_WORKERS=1
# LYCHEE_SECRET_KEY is injected from the central secret store, never stored here.
